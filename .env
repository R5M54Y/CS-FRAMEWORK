# WhatsApp CS Framework Configuration

# Main Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Session Port Range (each session gets its own port)
SESSION_PORT_START=3100
SESSION_PORT_END=3200

# Data Paths (relative to project root)
DATA_PATH=./data
SESSIONS_PATH=./sessions
LOGS_PATH=./logs
TEMP_PATH=./temp

# Baileys Configuration
BAILEYS_LOG_LEVEL=silent
CONNECTION_TIMEOUT=60000
QR_TIMEOUT=45000
RECONNECT_DELAY=5000
MAX_RECONNECT_ATTEMPTS=10

# Message Settings
DEFAULT_TYPING_DELAY=1000
DEFAULT_READ_DELAY=500
MAX_REPLY_LENGTH=4096
AUTO_REPLY=true

# AI Gateway (OpenAI-compatible endpoint — never connect directly to providers)
AI_ENDPOINT=http://localhost:20128/v1
AI_API_KEY=sk-95e49e1c4a999dbb-kh4jbu-750ae31a
AI_MODEL=free-forever

# AI Request Queue
AI_QUEUE_CONCURRENCY=3
AI_REQUEST_TIMEOUT=60000
AI_QUEUE_MAX_RETRIES=3
AI_QUEUE_BASE_DELAY=1000
AI_QUEUE_MAX_DELAY=30000

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14

# Security
SESSION_SECRET=whatsapp-cs-framework-secret-change-in-production
CORS_ORIGIN=*

# Feature Flags
ENABLE_QR_TERMINAL=true
ENABLE_QR_WEB=true
ENABLE_REALTIME=true
ENABLE_PRODUCTS=true
ENABLE_KNOWLEDGE=true
ENABLE_PERSONA=true