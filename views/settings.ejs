<%- include('partials/header') %>
<% const localSettings = settings || {}; const ai = localSettings.ai || {}; %>
<section class="settings-page">
    <div class="container">
        <h1>Settings</h1>
        
        <div class="settings-section">
            <h2>AI Gateway Settings</h2>
            <form id="ai-settings-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>AI Endpoint</label>
                        <input type="text" id="set-ai-endpoint" class="form-control" value="<%= ai.endpoint || '' %>">
                    </div>
                    <div class="form-group">
                        <label>AI API Key</label>
                        <input type="password" id="set-ai-api-key" class="form-control" value="<%= ai.hasApiKey ? '••••••••' : '' %>">
                        <small id="ai-key-help" class="form-text">Saved in Settings (single source of truth). Leave masked to keep current key.</small>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>AI Model</label>
                        <input type="text" id="set-ai-model" class="form-control" value="<%= ai.model || '' %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Save AI Settings</button>
            </form>
        </div>
    </div>
</section>

<script>
// AI Settings Form Handler
if (document.getElementById('ai-settings-form')) {
    document.getElementById('ai-settings-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = {
            aiEndpoint: document.getElementById('set-ai-endpoint').value,
            aiApiKey: document.getElementById('set-ai-api-key').value,
            aiModel: document.getElementById('set-ai-model').value
        };
        
        // Merge with existing settings structure
        const fullData = {
            server: {},
            ai: data,
            features: {}
        };
        
        const res = await fetch('/api/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(fullData)
        });
        if (res.ok) alert('AI settings saved!');
    });
}
</script>
<%- include('partials/footer') %>
