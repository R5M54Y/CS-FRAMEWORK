<%- include('partials/header') %>
<link rel="stylesheet" href="/css/conversation-inbox.css">
<link rel="stylesheet" href="/node_modules/dropzone/dist/min/dropzone.min.css">
<section class="session-dashboard">
    <div class="container">
        <div class="session-header">
            <div class="session-info">
                <h1><%= session.displayName || session.id.substring(0, 8) %></h1>
                <p><%= session.phoneNumber || 'No phone number' %></p>
            </div>
            <div class="session-controls">
                <button class="btn" id="connect-btn" onclick="sessionAction()">
                    <span id="connect-btn-text"><%= session.connected ? '⏹ Disconnect' : (session.state === 'connecting' ? '⏳ Connecting...' : '🔗 Connect') %></span>
                </button>
                <button class="btn btn-secondary" onclick="sessionAction('restart')">🔃 Restart</button>
                <a href="/" class="btn btn-outline">← Dashboard</a>
            </div>
        </div>

        <div class="status-grid">
            <div class="status-card">
                <h4>Status</h4>
                <div class="status-badge-large status-<%= session.state %>"><%= session.state %></div>
                <% if (session.state === 'paused') { %>
                    <div class="bot-status-badge paused">PAUSED</div>
                <% } %>
            </div>
            <div class="status-card">
                <h4>Internal ID</h4>
                <div class="status-value"><%= session.holder || session.name || session.id.substring(0, 8) %></div>
            </div>
            <div class="status-card">
                <h4>Phone</h4>
                <div class="status-value"><%= session.phoneNumber ? session.phoneNumber.match(/^\d+/)?.[0] : '—' %></div>
            </div>
            <div class="status-card">
                <h4>Uptime</h4>
                <div class="status-value" id="uptime-display" data-uptime-start="<%= session.startTime || '' %>"><%= session.uptimeFormatted %></div>
            </div>
            <div class="status-card">
                <h4>Messages</h4>
                <div class="status-value" id="message-count"><%= session.messageCount %></div>
            </div>
        </div>

        <!-- QR Modal -->
        <div class="modal-overlay" id="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title">
            <div class="modal">
                <div class="modal-header">
                    <h3 id="qr-modal-title">🔐 Scan QR Code</h3>
                    <button class="modal-close" onclick="closeQRModal()" aria-label="Close QR Modal">×</button>
                </div>
                <div class="modal-body" style="text-align: center; padding: 2rem;">
                    <div class="qr-container">
                        <img id="qr-modal-image" src="/img/qr-code.gif" alt="QR Code" style="width: 256px; height: 256px; border: 4px solid white; border-radius: var(--radius); box-shadow: var(--shadow);" />
                    </div>
                    <p style="margin-top: 1rem; color: var(--text-muted); font-size: 0.9rem;">Open WhatsApp on your phone → Linked Devices → Link a Device</p>
                    <button class="btn btn-sm btn-outline" onclick="regenerateQR()" style="margin-top: 1rem;">🔄 Refresh QR</button>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-bar">
            <button class="tab-btn active" data-tab="chats" onclick="switchTab('chats')">💬 Chats</button>
            <button class="tab-btn" data-tab="persona" onclick="switchTab('persona')">🎭 Persona</button>
            <button class="tab-btn" data-tab="knowledge" onclick="switchTab('knowledge')">📚 Knowledge</button>
            <button class="tab-btn" data-tab="gallery" onclick="switchTab('gallery')">🖼️ Gallery</button>
        </div>

        <!-- TAB: Chats -->
        <div class="tab-panel active" id="tab-chats">
            <div class="conversation-container" id="conversation-container">
                <!-- Left Column - Chat List -->
                <div class="chat-list">
                    <div class="chat-list-header">
                        <h3>💬 Conversations</h3>
                    </div>
                    <div class="chat-search">
                        <input type="text" id="chat-search" placeholder="Search conversations..." autocomplete="off">
                    </div>
                    <div class="chat-list-container" id="chat-list-container">
                        <div class="empty-state">
                            <div class="empty-state-icon">💬</div>
                            <h3>Loading conversations...</h3>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Conversation View -->
                <div class="conversation-view">
                    <div class="conversation-header">
                        <div class="participant-info">
                            <div class="participant-avatar" id="participant-avatar">👤</div>
                            <div>
                                <div class="participant-name" id="participant-name">Select a conversation</div>
                                <div class="participant-meta">
                                    <span class="badge badge-info" id="bot-status-badge">🤖 AUTO</span>
                                    <span class="chat-time" id="participant-time"></span>
                                </div>
                            </div>
                        </div>
                        <div class="bot-toggle-container">
                            <div class="bot-toggle active" id="bot-toggle" onclick="toggleBotStatus()">
                                <span class="bot-icon">🤖</span>
                                <span class="bot-label" id="bot-label">BOT ACTIVE</span>
                                <span class="bot-status-dot active" id="bot-status-dot"></span>
                            </div>
                        </div>
                    </div>
                    <div class="messages-container" id="messages-container">
                        <div class="empty-state">
                            <div class="empty-state-icon">💬</div>
                            <h3>No Conversation Selected</h3>
                            <p>Click on a conversation from the left to start messaging</p>
                        </div>
                    </div>
                    <div class="reply-box">
                        <div class="reply-box-container">
                            <form id="reply-form" class="reply-input-container" onsubmit="sendMessage(event)">
                                <textarea 
                                    id="reply-textarea" 
                                    class="reply-textarea" 
                                    placeholder="Type a message..." 
                                    rows="1"
                                    disabled
                                ></textarea>
                                <button type="submit" class="reply-button" id="send-button" disabled>📨</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: Persona -->
        <div class="tab-panel" id="tab-persona">
            <div class="persona-panel">
                <div class="persona-form">
                    <div class="form-group">
                        <label for="persona-prompt">AI Personality Prompt</label>
                        <textarea 
                            id="persona-prompt" 
                            class="form-control persona-textarea" 
                            rows="10" 
                            placeholder="Enter AI personality prompt...&#10;&#10;Example: You are a friendly customer service agent for a tech company. You are helpful, patient, and professional. Always greet customers warmly and try to resolve their issues quickly."
                        ></textarea>
                    </div>
                    <div class="persona-actions">
                        <button class="btn btn-primary" id="save-persona-btn" onclick="savePersona()">
                            💾 Save Persona
                        </button>
                        <span class="persona-status" id="persona-status"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: Knowledge -->
        <div class="tab-panel" id="tab-knowledge">
            <div class="knowledge-panel">
                <div class="knowledge-form">
                    <!-- Knowledge Prompt -->
                    <div class="form-group">
                        <label for="knowledge-prompt">Knowledge Prompt</label>
                        <textarea 
                            id="knowledge-prompt" 
                            class="form-control knowledge-textarea" 
                            rows="10" 
                            placeholder="Additional instructions for the AI about your products, services, FAQs, etc...&#10;&#10;Example: Our company sells electronics. Our return policy is 30 days. Support hours are 9am-6pm WIB."
                        ></textarea>
                    </div>

                    <!-- Marketplace URL -->
                    <div class="form-group">
                        <label for="marketplace-url">Marketplace URL</label>
                        <input 
                            type="text" 
                            id="marketplace-url" 
                            class="form-control" 
                            placeholder="https://tokopedia.com/your-store"
                        >
                        <small class="form-help">Link to your marketplace store for product references</small>
                    </div>

                    <!-- Knowledge Files - Upload Area -->
                    <div class="form-group">
                        <label>Knowledge Files</label>
                        <div class="knowledge-dropzone" id="knowledge-dropzone">
                            <div class="dropzone-content">
                                <span class="dropzone-icon">📁</span>
                                <p>Drag & drop files here, or <span class="dropzone-browse">browse</span></p>
                                <small>Supports PDF, TXT, CSV, MD, JSON + Images (PNG, JPG, GIF, WebP, SVG) + Videos (MP4, WebM, OGG) — max 50MB</small>
                            </div>
                            <input type="file" id="knowledge-file-input" multiple accept=".pdf,.txt,.csv,.md,.json,.png,.jpg,.jpeg,.gif,.webp,.svg,.mp4,.webm,.ogg,.mov,.avi,.wmv" style="display:none">
                        </div>
                    </div>

                    <!-- Uploaded Files List -->
                    <div class="form-group">
                        <label>Uploaded Files</label>
                        <div class="knowledge-files-list" id="knowledge-files-list">
                            <div class="empty-files-state">
                                <p>No files uploaded yet</p>
                            </div>
                        </div>
                    </div>

                    <!-- Save Button -->
                    <div class="knowledge-actions">
                        <button class="btn btn-primary" id="save-knowledge-btn" onclick="saveKnowledgeConfig()">
                            💾 Save Knowledge
                        </button>
                        <span class="knowledge-status" id="knowledge-status"></span>
                    </div>
                </div>
            </div>

            <!-- TAB: Gallery -->
            <div class="tab-panel" id="tab-gallery">
                <div class="gallery-panel">
                    <h3>🖼️ Gallery</h3>
                    <div id="gallery-dropzone">
                        <div class="dz-message">Drag & drop images here or click to upload</div>
                    </div>
                    <div id="gallery-preview-grid" class="gallery-preview-grid"></div>
                    <div id="gallery-grid"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="/node_modules/dropzone/dist/min/dropzone.min.js"></script>
<script>
const sessionId = '<%= session.id %>';
const _API_TOKEN = '<%= typeof apiToken !== 'undefined' ? apiToken : '' %>';
const socket = io();
socket.emit('join-session', sessionId);

let selectedParticipant = null;
let messagesCache = [];
let qrModalOpen = false;

// === UTILITY FUNCTIONS ===
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function formatTime(timestamp) {
    if (!timestamp) return '';
    const date = new Date(timestamp);
    const now = new Date();
    const diff = now - date;
    
    if (diff < 60000) return 'Just now';
    if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
    if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
    
    return date.toLocaleDateString('id-ID', {
        day: '2-digit',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit'
    });
}

function formatFileSize(bytes) {
    if (!bytes) return '0 B';
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(1) + ' ' + sizes[i];
}

// === TOAST NOTIFICATIONS ===
function showToast(message, type) {
    let container = document.getElementById('toast-container');
    if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.style.cssText = 'position:fixed;top:1.5rem;right:1.5rem;z-index:2000;display:flex;flex-direction:column;gap:0.5rem;';
        document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    toast.style.cssText = `
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius);
        color: white;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: var(--shadow-lg);
        animation: toastIn 0.3s ease;
        background: ${type === 'success' ? 'var(--success)' : type === 'error' ? 'var(--danger)' : 'var(--info)'};
    `;
    container.appendChild(toast);
    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

// === TAB SWITCHING ===
let currentTab = 'chats';
function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tab);
    });
    document.querySelectorAll('.tab-panel').forEach(panel => {
        panel.classList.toggle('active', panel.id === 'tab-' + tab);
    });
    // Load data on tab switch
    if (tab === 'persona') loadPersona();
    else if (tab === 'knowledge') { loadKnowledgeConfig(); loadKnowledgeFiles(); }
    else if (tab === 'gallery') loadGallery();
}

// === QR MODAL FUNCTIONS ===
function openQRModal(qrImage) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-modal-image');
    if (qrImage) {
        img.src = qrImage;
    }
    modal.classList.add('active');
    qrModalOpen = true;
    document.body.style.overflow = 'hidden';
}

function closeQRModal() {
    const modal = document.getElementById('qr-modal');
    modal.classList.remove('active');
    qrModalOpen = false;
    document.body.style.overflow = '';
}

// Close modal on overlay click
document.getElementById('qr-modal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeQRModal();
});

// Close modal on Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && qrModalOpen) closeQRModal();
});

// === CUSTOM DIALOG SYSTEM ===
let dialogResolve = null;
function dialog(html) {
    return new Promise((resolve) => {
        dialogResolve = resolve;
        const d = document.getElementById('custom-dialog');
        const b = d.querySelector('.dialog-body');
        b.innerHTML = html;
        d.classList.add('active');
        const input = d.querySelector('input, textarea, select');
        if (input) setTimeout(() => input.focus(), 100);
    });
}
function dialogClose(result) {
    document.getElementById('custom-dialog').classList.remove('active');
    if (dialogResolve) {
        dialogResolve(result);
        dialogResolve = null;
    }
}
function dialogOk() {
    const inputs = document.querySelectorAll('#custom-dialog .dialog-input');
    const data = {};
    inputs.forEach(i => {
        if (i.type === 'checkbox') data[i.name || i.id] = i.checked;
        else data[i.name || i.id] = i.value;
    });
    dialogClose(data);
}
async function dialogAlert(msg) {
    await dialog(`<p>${msg}</p><div class="dialog-actions"><button class="btn btn-primary" onclick="dialogClose(true)">OK</button></div>`);
}
async function dialogConfirm(msg) {
    return await dialog(`<p>${msg}</p><div class="dialog-actions"><button class="btn btn-secondary" onclick="dialogClose(false)">Cancel</button><button class="btn btn-primary" onclick="dialogClose(true)">OK</button></div>`);
}

// === SESSION ACTIONS ===
async function sessionAction(action) {
    if (!action) {
        const btn = document.getElementById('connect-btn');
        if (btn.classList.contains('btn-warning')) action = 'disconnect';
        else action = 'connect';
    }
    try {
        const res = await fetch('/api/session/' + sessionId + '/' + action, { method: 'POST' });
        const data = await res.json();
        if (data.error) dialogAlert('Error: ' + data.error);
        else {
            if (action === 'connect') {
                updateConnectButton('connecting');
            } else if (action === 'disconnect') {
                updateConnectButton('disconnected');
            } else if (action === 'restart') {
                updateConnectButton('connecting');
            }
        }
    } catch (err) { dialogAlert('Error: ' + err.message); }
}

function updateConnectButton(state) {
    const btn = document.getElementById('connect-btn');
    const btnText = document.getElementById('connect-btn-text');
    btn.classList.remove('btn-success', 'btn-warning', 'btn-info');
    
    if (state === 'connected') {
        btn.classList.add('btn-warning');
        btnText.textContent = '⏹ Disconnect';
        btn.disabled = false;
        closeQRModal();
    } else if (state === 'connecting') {
        btn.classList.add('btn-info');
        btnText.textContent = '⏳ Connecting...';
        btn.disabled = true;
    } else {
        btn.classList.add('btn-success');
        btnText.textContent = '🔗 Connect';
        btn.disabled = false;
    }
}

async function regenerateQR() {
    const img = document.getElementById('qr-modal-image');
    img.src = '/img/qr-code.gif';
    img.alt = 'Generating a new QR code...';

    try {
        const res = await fetch('/api/session/' + sessionId + '/qrcode/regenerate', { method: 'POST' });
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'Failed to regenerate QR');
        await loadQR();
    } catch (err) {
        img.alt = 'QR regeneration failed';
        console.error('[QR] regenerate failed:', err);
    }
}

async function loadQR() {
    const res = await fetch('/api/session/' + sessionId + '/qrcode');
    const data = await res.json();
    if (!res.ok || data.error) {
        document.getElementById('qr-modal-image').alt = data.error || 'Failed to load QR code';
        setTimeout(loadQR, 3000);
        return;
    }
    if (data.qrImage) {
        openQRModal(data.qrImage);
    } else {
        document.getElementById('qr-modal-image').alt = 'QR not ready yet — waiting...';
        document.getElementById('qr-modal-image').src = '';
        setTimeout(loadQR, 3000);
    }
}

// Initialize button state from server
document.addEventListener('DOMContentLoaded', () => {
    const initialConnected = <%= session.connected ? 'true' : 'false' %>;
    const initialState = '<%= session.state %>';
    if (initialConnected) updateConnectButton('connected');
    else if (initialState === 'connecting') updateConnectButton('connecting');
    else updateConnectButton('disconnected');
    
    if (!initialConnected && initialState !== 'connected') {
        loadQR();
    }
});

// Socket events
socket.on('session:qr', (data) => { 
    if (data.sessionId === sessionId) {
        loadQR();
    }
});
socket.on('session:status', (data) => { 
    if (data.sessionId === sessionId) {
        updateConnectButton(data.state === 'connected' ? 'connected' : (data.state === 'connecting' ? 'connecting' : 'disconnected'));
    }
});
socket.on('session:ready', (data) => { 
    if (data.sessionId === sessionId) {
        updateConnectButton('connected');
    }
});
socket.on('session:message', (data) => { 
    if (data.sessionId === sessionId) {
        if (selectedParticipant && (data.user === selectedParticipant || data.from === selectedParticipant)) {
            appendMessage(data);
        }
        loadConversations();
    }
});
socket.on('session:sent', (data) => { 
    if (data.sessionId === sessionId && selectedParticipant && (data.user === selectedParticipant || data.to === selectedParticipant)) {
        appendMessage(data);
    }
});
socket.on('bot:state', (data) => {
    if (data.sessionId === sessionId && selectedParticipant) {
        updateBotStatusUI();
    }
});

// === CONVERSATION INBOX ===
async function loadConversations() {
    try {
        const res = await fetch('/api/session/' + sessionId + '/conversations');
        const conversations = await res.json();
        renderConversations(conversations);
    } catch (e) {
        console.error('Failed to load conversations:', e);
    }
}

function renderConversations(conversations) {
    const container = document.getElementById('chat-list-container');
    if (!container) return;
    
    if (conversations.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-icon">💬</div>
                <h3>No Conversations</h3>
                <p>No customer conversations yet</p>
            </div>
        `;
        return;
    }
    
    container.innerHTML = conversations.map(conv => {
        const avatarLetter = conv.name ? conv.name.charAt(0).toUpperCase() : '?';
        const unreadCount = conv.unread > 0 ? `<div class="chat-unread">${conv.unread}</div>` : '';
        const statusBadge = conv.botPausedBy ? 
            `<span class="badge ${conv.botPausedBy === 'human' ? 'badge-info' : 'badge-warning'}">${conv.botPausedBy === 'human' ? '👤' : '⏸'} ${conv.botPausedBy === 'human' ? 'HUMAN' : 'PAUSED'}</span>` :
            `<span class="badge badge-success">🤖 AUTO</span>`;
        
        return `
            <div class="chat-item ${selectedParticipant === conv.name ? 'selected' : ''}" data-participant="${conv.name}" onclick="selectConversation('${conv.name}')">
                <div class="chat-avatar ${conv.avatar ? '' : 'offline'}">
                    ${conv.avatar ? `<img src="${conv.avatar}" alt="${conv.name}">` : avatarLetter}
                </div>
                <div class="chat-info">
                    <div class="chat-name">
                        ${conv.name}
                        ${statusBadge}
                    </div>
                    <div class="chat-preview">
                        ${escapeHtml(conv.lastMessage || '(No messages yet)')}
                    </div>
                    <div class="chat-meta">
                        <span class="chat-time">${formatTime(conv.timestamp)}</span>
                        ${unreadCount}
                    </div>
                </div>
            </div>
        `;
    }).join('');
}

async function selectConversation(participant) {
    selectedParticipant = participant;
    
    document.querySelectorAll('.chat-item').forEach(item => {
        item.classList.toggle('selected', item.dataset.participant === participant);
    });
    
    await loadMessages();
    await loadConversationStatus();
    
    document.getElementById('reply-textarea').disabled = false;
    document.getElementById('send-button').disabled = false;
    
    document.getElementById('participant-name').textContent = participant;
    document.getElementById('participant-avatar').textContent = participant ? participant.charAt(0).toUpperCase() : '👤';
    
    const messagesContainer = document.getElementById('messages-container');
    if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
}

async function loadMessages() {
    if (!selectedParticipant) return;
    
    try {
        const res = await fetch('/api/session/' + sessionId + '/conversations/' + encodeURIComponent(selectedParticipant) + '/messages');
        const messages = await res.json();
        renderMessages(messages);
    } catch (e) {
        console.error('Failed to load messages:', e);
    }
}

function renderMessages(messages) {
    const container = document.getElementById('messages-container');
    if (!container) return;
    
    if (messages.length === 0) {
        container.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-icon">💬</div>
                <h3>No Messages</h3>
                <p>Start a conversation with ${selectedParticipant}</p>
            </div>
        `;
        return;
    }
    
    container.innerHTML = messages.map(msg => {
        const isOutgoing = msg.isOutgoing || msg.to === selectedParticipant;
        const isFromMe = msg.user === 'human' || msg.fromMe;
        const bubbleClass = isFromMe ? 'human' : (msg.user === 'bot' ? 'bot' : 'customer');
        
        return `
            <div class="message-wrapper ${isOutgoing ? 'right' : 'left'}">
                <div class="message-bubble ${bubbleClass}">
                    <div class="message-content">
                        ${escapeHtml(msg.content || '')}
                    </div>
                    <div class="message-footer">
                        <span class="message-time">${formatTime(msg.timestamp)}</span>
                    </div>
                </div>
            </div>
        `;
    }).join('');
    
    setTimeout(() => {
        container.scrollTop = container.scrollHeight;
    }, 100);
}

function appendMessage(msg) {
    const container = document.getElementById('messages-container');
    if (!container) return;
    
    const emptyState = container.querySelector('.empty-state');
    if (emptyState) emptyState.remove();
    
    const isOutgoing = msg.isOutgoing || msg.to === selectedParticipant;
    const isFromMe = msg.user === 'human' || msg.fromMe;
    const bubbleClass = isFromMe ? 'human' : (msg.user === 'bot' ? 'bot' : 'customer');
    
    const div = document.createElement('div');
    div.className = `message-wrapper ${isOutgoing ? 'right' : 'left'}`;
    div.innerHTML = `
        <div class="message-bubble ${bubbleClass}">
            <div class="message-content">
                ${escapeHtml(msg.content || '')}
            </div>
            <div class="message-footer">
                <span class="message-time">${formatTime(msg.timestamp)}</span>
            </div>
        </div>
    `;
    
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

async function loadConversationStatus() {
    if (!selectedParticipant) return;
    
    try {
        const res = await fetch('/api/session/' + sessionId + '/conversations/status?jid=' + encodeURIComponent(selectedParticipant));
        const status = await res.json();
        updateBotStatusUI(status);
    } catch (e) {
        console.error('Failed to load conversation status:', e);
    }
}

async function updateBotStatusUI(status) {
    const botToggle = document.getElementById('bot-toggle');
    const botLabel = document.getElementById('bot-label');
    const botStatusDot = document.getElementById('bot-status-dot');
    const botStatusBadge = document.getElementById('bot-status-badge');
    
    if (!botToggle) return;
    
    if (status) {
        const isBotEnabled = status.botEnabled;
        const botPausedBy = status.botPausedBy;
        
        botToggle.className = `bot-toggle ${isBotEnabled ? 'active' : 'inactive'}`;
        botLabel.textContent = isBotEnabled ? 'BOT ACTIVE' : 'BOT PAUSED';
        botStatusDot.className = `bot-status-dot ${isBotEnabled ? 'active' : 'inactive'}`;
        
        if (botPausedBy === 'human') {
            botLabel.title = 'Bot paused by human agent';
            botStatusBadge.className = 'badge badge-warning';
            botStatusBadge.innerHTML = '👤 HUMAN';
        } else if (botPausedBy) {
            botLabel.title = `Bot paused (${botPausedBy})`;
            botStatusBadge.className = 'badge badge-warning';
            botStatusBadge.innerHTML = '⏸ PAUSED';
        } else {
            botStatusBadge.className = 'badge badge-success';
            botStatusBadge.innerHTML = '🤖 AUTO';
        }
    }
}

async function toggleBotStatus() {
    try {
        const botToggle = document.getElementById('bot-toggle');
        const action = botToggle.classList.contains('active') ? 'pause' : 'resume';
        
        const res = await fetch('/api/session/' + sessionId + '/bot/' + action, { method: 'POST' });
        const data = await res.json();
        
        if (data.error) {
            showToast('Error: ' + data.error, 'error');
            return;
        }
        
        await loadConversationStatus();
        showToast(`Bot ${action}ed successfully`, 'success');
    } catch (e) {
        console.error('Failed to toggle bot status:', e);
        showToast('Failed to toggle bot status', 'error');
    }
}

async function sendMessage(e) {
    e.preventDefault();
    
    const textarea = document.getElementById('reply-textarea');
    const content = textarea.value.trim();
    
    if (!content || !selectedParticipant) return;
    
    try {
        const sendButton = document.getElementById('send-button');
        sendButton.disabled = true;
        sendButton.innerHTML = '<div class="loading-spinner"></div>';
        
        const res = await fetch('/api/session/' + sessionId + '/conversations/reply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                to: selectedParticipant + '@s.whatsapp.net',
                content: content
            })
        });
        
        const data = await res.json();
        
        textarea.value = '';
        textarea.style.height = '44px';
        
        if (data.success) {
            showToast('Message sent', 'success');
        } else {
            showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
        }
    } catch (err) {
        console.error('Failed to send message:', err);
        showToast('Failed to send message', 'error');
    } finally {
        const sendButton = document.getElementById('send-button');
        sendButton.disabled = false;
        sendButton.innerHTML = '📨';
    }
}

