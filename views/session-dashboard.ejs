async function loadKnowledgeFiles() {
    try {
        const res = await fetch('/api/session/' + sessionId + '/knowledge-files');
        const files = await res.json();
        renderKnowledgeFiles(files);
    } catch (e) {
        console.error('Failed to load knowledge files:', e);
    }
}

function renderKnowledgeFiles(files) {
    const container = document.getElementById('knowledge-files-list');
    if (!container) return;
    
    if (!files || files.length === 0) {
        container.innerHTML = '<div class="empty-files-state"><p>No files uploaded yet</p></div>';
        return;
    }
    
    container.innerHTML = files.map(file => {
        const icon = getFileIcon(file.originalname || file.name);
        const size = formatFileSize(file.size);
        const date = file.uploadedAt ? new Date(file.uploadedAt).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '';
        
        return `
            <div class="knowledge-file-item">
                <div class="file-info">
                    <span class="file-icon">${icon}</span>
                    <div class="file-details">
                        <span class="file-name">${escapeHtml(file.originalname || file.name)}</span>
                        <span class="file-meta">${size} · ${date}</span>
                    </div>
                </div>
                <div class="file-actions">
                    <a href="/api/session/${sessionId}/knowledge-files/${file.id || file._id}/download" class="btn btn-sm btn-outline" title="Download">⬇️</a>
                    <button class="btn btn-sm btn-danger" onclick="deleteKnowledgeFile('${file.id || file._id}')" title="Delete">🗑️</button>
                </div>
            </div>
        `;
    }).join('');
}

function getFileIcon(filename) {
    if (!filename) return '📄';
    const ext = filename.split('.').pop().toLowerCase();
    const icons = { pdf: '📕', txt: '📝', csv: '📊', md: '📑', json: '📋' };
    return icons[ext] || '📄';
}

async function deleteKnowledgeFile(fileId) {
    const confirmed = await dialogConfirm('Delete this file?');
    if (!confirmed) return;
    
    try {
        const res = await fetch('/api/session/' + sessionId + '/knowledge-files/' + fileId, { method: 'DELETE' });
        const data = await res.json();
        if (data.error) {
            showToast('Error: ' + data.error, 'error');
