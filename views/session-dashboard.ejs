async function loadKnowledgeConfig() {
    try {
        const res = await fetch('/api/session/' + sessionId + '/knowledge-config');
        const data = await res.json();
        document.getElementById('knowledge-prompt').value = data.knowledge || '';
        document.getElementById('marketplace-url').value = data.marketplaceUrl || '';
