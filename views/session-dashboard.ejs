let galleryDropzone = null;

function initGalleryDropzone() {
    if (typeof Dropzone === 'undefined') { console.warn('Dropzone not loaded'); return; }
    const el = document.getElementById('gallery-dropzone');
    if (!el) return;
    galleryDropzone = new Dropzone('#gallery-dropzone', {
        url: '/api/session/' + sessionId + '/gallery',
        maxFilesize: 50,
        maxFiles: 10,
        acceptedFiles: 'image/*',
        addRemoveLinks: true,
        headers: { 'Authorization': 'Bearer ' + _API_TOKEN },
        success: function(file, resp) {
            showToast('Uploaded successfully', 'success');
            loadGallery();
        },
        error: function(file, resp) {
            showToast('Upload failed: ' + (resp.error || resp), 'error');
        }
    });
}

async function loadGallery() {
    const grid = document.getElementById('gallery-preview-grid');
    if (!grid) return;
    grid.innerHTML = '<p>Loading...</p>';
    try {
        const res = await fetch('/api/session/' + sessionId + '/gallery');
        const files = await res.json();
        if (!Array.isArray(files) || files.length === 0) {
            grid.innerHTML = '<p>No images uploaded yet</p>';
            return;
        }
        grid.innerHTML = files.map(f =>
            '<div style="border:1px solid #ddd;padding:8px;border-radius:4px;text-align:center">' +
            '<img src="/api/session/' + sessionId + '/gallery/' + f.id + '/download" style="max-width:100%;max-height:150px" /><br/>' +
            '<small>' + (f.originalName || '') + '</small>' +
            '<br/><button onclick="deleteGallery(\'' + f.id + '\')" style="margin-top:4px;font-size:12px">Delete</button>' +
            '</div>'
        ).join('');
    } catch(e) {
        grid.innerHTML = '<p style="color:red">Failed to load gallery</p>';
    }
}

async function deleteGallery(fileId) {
    if (!confirm('Delete this image?')) return;
    try {
        const res = await fetch('/api/session/' + sessionId + '/gallery/' + fileId, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + _API_TOKEN } });
        const data = await res.json();
        if (data.success) { showToast('Deleted', 'success'); loadGallery(); }
        else showToast('Delete failed', 'error');
    } catch(e) {
        showToast('Delete failed', 'error');
    }
}

// Initialize gallery when page loads
document.addEventListener('DOMContentLoaded', function() {
    // Delay init to ensure Dropzone script is loaded
    setTimeout(initGalleryDropzone, 500);
});
