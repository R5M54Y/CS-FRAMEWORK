<%- include('partials/header') %>
<section class="error-page">
    <div class="container" style="text-align:center;padding:4rem 2rem;">
        <div style="font-size:5rem;margin-bottom:1rem;">
            <%= typeof status !== 'undefined' && status === 404 ? '🔍' : '⚠️' %>
        </div>
        <h1><%= typeof status !== 'undefined' ? status : 500 %></h1>
        <p><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></p>
        <a href="/" class="btn btn-primary" style="margin-top:1rem;">← Back to Dashboard</a>
    </div>
</section>
<%- include('partials/footer') %>